{
  "expo": {
    "name": "OpenFlight",
    "slug": "openlaunch-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openflight.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "OpenFlight uses Bluetooth to connect to the launch monitor.",
        "NSBluetoothPeripheralUsageDescription": "OpenFlight uses Bluetooth to connect to the launch monitor."
      }
    },
    "android": {
      "package": "com.openflight.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow OpenFlight to use Bluetooth to connect to your launch monitor"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/openlaunch-mobile"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
