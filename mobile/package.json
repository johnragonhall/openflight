{
  "name": "openlaunch-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "test": "jest --watchAll=false"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@op-engineering/op-sqlite": "^16.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.0",
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "expo": "^56.0.11",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-location": "~56.0.17",
    "expo-modules-core": "^56.0.16",
    "expo-print": "~56.0.4",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.17",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "postcss": ">=8.5.15",
    "@xmldom/xmldom": ">=0.9.10",
    "uuid": ">=9.0.1",
    "fast-xml-parser": ">=5.0.0",
    "tar": ">=6.2.1",
    "send": ">=0.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "^56.0.15",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "jest": "29.7.0",
    "jest-expo": "~56.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
